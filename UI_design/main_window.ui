/* QStackedWidget Base Style */
QStackedWidget {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, 
                                stop:0 #f2f6f9, stop:1 #e0e5ec);
    border: 2px solid #dcdfe3;
    border-radius: 18px;
    padding: 10px;
}

/* Optional: Pages inside the stacked widget */
QStackedWidget &gt; QWidget {
    background: transparent;
    border-radius: 12px;
}
