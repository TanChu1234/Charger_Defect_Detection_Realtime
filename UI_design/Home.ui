  <property name="styleSheet">
   <string notr="true">QMainWindow {
                background-color: rgb(255, 255, 255); /* Dark background for the main window */
            }

            QLabel, QPushButton, QTextEdit {
                color: #ffffff; /* White text for readability */
                background-color: #333333; /* Slightly lighter dark gray for widgets */
                border: 1px solid #444444;
                padding: 5px;
                border-radius: 4px;
            }
			
            QTabWidget::pane { /* The tab widget frame */
                border-top: 2px solid #333333;
            }

            QTabBar::tab {
                background: #2b2b2b;
                color: #ccc;
                border: 2px solid #333333;
                border-bottom-color: #333333; /* same as the pane color */
                border-top-left-radius: 4px;
                border-top-right-radius: 4px;
                min-width: 8ex;
                padding: 5px;
            }

            QTabBar::tab:selected, QTabBar::tab:hover {
                background: #3c3c3c;
                color: #ffffff;
                border-color: #0057b7; /* Blue border for selected/hover */
            }

            QTabBar::tab:selected {
                border-color: #333333;
                border-bottom-color: #3c3c3c; /* same as pane color */
            }

            QPushButton:hover {
                background-color: #505050;
                border: 3px solid #0066cc;; /* Blue border for button hover */
            }

     		QMessageBox {
        			background-color: #ffffff; /* White background for the message box */
        			color: rgb(255, 255, 255); /* Black text for general content */
    			}
    		QMessageBox QPushButton {
        			background-color: #8c8c8c;
        			border: none;
       			}
    		QMessageBox QLabel {
        			background-color: #ffffff; /* White background for the message box */
        			color: rgb(0, 0, 0); /* Explicitly setting label text color to black */
        			border: none;
    			}</string>
  </property>
  <widget class="QWidget" name="centralWidget">
