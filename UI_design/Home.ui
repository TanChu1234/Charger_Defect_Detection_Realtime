    <property name="styleSheet">
     <string notr="true">            QMainWindow {
                background-color: #333333; /* Dark background for the main window */
            }

            QPushButton, QTextEdit {
                color: black; /* White text for readability */
                background-color: #e7e7e7; /* Slightly lighter dark gray for widgets */
                border: 1px solid #444444;
                padding: 5px;
                border-radius: 4px;
            }
			
            QTabWidget::pane { /* The tab widget frame */
                border-top: 2px solid #f3f3f3;
            }
            QTabBar::tab {
   				width: 90px;
				height: 20px;
                background: #f3f3f3;
                color: rgb(0, 0, 0);
                border: 1px;
                min-width: 8ex;
                padding: 5px;
            }

            QTabBar::tab:selected, QTabBar::tab:hover {
				background: #e7e7e7;
				border-top: 3px solid #0f52ba;
            }


            QPushButton:hover {
 				 background-color: rgb(60, 170, 255);
                border: 1px solid #0066cc;; /* Blue border for button hover */
            }

QScrollBar:vertical {
                background: #2e2e2e;
                width: 14px;
                margin: 15px 3px 15px 3px;
                border: 1px solid #222222;
                border-radius: 5px;
            }

QScrollBar::handle:vertical {
                background: #5c90d2;
                min-height: 20px;
                border-radius: 5px;
            }

QScrollBar::handle:vertical:hover {
                background: #787878;
            }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
                background: none;
            }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
                background: none;
            }

 			QRadioButton {
    			color: #b1b1b1; /* Default text color */
    			spacing: 5px; /* Spacing around text and icon */
			}
			QRadioButton::indicator {
    			width: 13px;
    			height: 13px;
    			border-radius: 7px; /* Circular indicators */
			}
			QRadioButton::indicator:unchecked {
    			background-color: #cae1ff; /* Light gray background when unchecked */
   			 	border: 1px solid #0066cc; /* Gray border */
			}
			QRadioButton::indicator:checked {
    			background-color: #5c90d2; /* Blue background when checked */
    			border: 1px solid #0066cc; /* Darker blue border */
			}

			QRadioButton::indicator:hover {
    			background-color: #5c90d2; /* Darker grey background when checked */
                border: 2px solid #0066cc; /* White border when checked */
			}
			QRadioButton::indicator:checked:hover {
    			background-color: #5c90d2; /* Darker grey background when checked */
                border: 1px solid #0066cc; /* White border when checked */
			}
QMessageBox {
        			background-color: #ffffff; /* White background for the message box */
        			color: rgb(255, 255, 255); /* Black text for general content */
    			}
    		QMessageBox QPushButton {
        			background-color: #8c8c8c;
        			border: none;
       			}
    		QMessageBox QLabel {
        			background-color: #ffffff; /* White background for the message box */
        			color: rgb(0, 0, 0); /* Explicitly setting label text color to black */
        			border: none;
    			}
</string>
